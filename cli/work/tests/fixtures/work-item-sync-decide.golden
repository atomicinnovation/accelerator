# The sync-decision golden.
#
# [DECIDE]  <direction>|<state>|<dirty>|<expected-action>
# [TOKEN]   <raw>|<expected-resolution>
#
# direction ∈ bidirectional|push-only|pull-only
# state ∈ synced|synced/record|unsynced|locally-modified
#          |locally-modified/withheld|locally-modified/record
#          |locally-modified/retitle|remotely-modified|conflict|remote-absent
#          |indeterminate
#   synced/record is a synced item whose baseline only needs rewriting.
#   locally-modified sends the body and the title; /withheld sends the body
#   alone, /retitle the title alone, and /record sends nothing, only
#   rewriting the baseline.
# dirty ∈ 0|1|unknown — consulted only by the remotely-modified row, where
#   unknown decides as dirty, the fail-safe; every other state ignores it, so
#   it is fixed at 0 there, bar one synced/record row showing a dirty file
#   still records.
# expected (DECIDE) ∈ push|push-without-title|retitle|pull|skip-conflict
#   |skip-dirty|prompt|noop|record-baseline
# expected (TOKEN) ∈ accept-remote|push-local|skip
#
# (empty) is the empty-value sentinel.
#
# (nbsp) marks a leading U+00A0 in <raw>, invisible in review otherwise. It
# must resolve to skip: a Unicode-aware fold-and-trim would resolve it to
# accept-remote instead, turning the deliberately safe default into a local
# overwrite for whitespace no human can see.

[DECIDE]
bidirectional|synced|0|noop
push-only|synced|0|noop
pull-only|synced|0|noop
bidirectional|unsynced|0|noop
push-only|unsynced|0|noop
pull-only|unsynced|0|noop
bidirectional|remote-absent|0|noop
push-only|remote-absent|0|noop
pull-only|remote-absent|0|noop
bidirectional|indeterminate|0|noop
push-only|indeterminate|0|noop
pull-only|indeterminate|0|noop
bidirectional|locally-modified|0|push
push-only|locally-modified|0|push
pull-only|locally-modified|0|noop
bidirectional|remotely-modified|0|pull
push-only|remotely-modified|0|noop
pull-only|remotely-modified|0|pull
bidirectional|remotely-modified|1|prompt
push-only|remotely-modified|1|noop
pull-only|remotely-modified|1|skip-dirty
bidirectional|conflict|0|prompt
push-only|conflict|0|skip-conflict
pull-only|conflict|0|skip-conflict
bidirectional|remotely-modified|unknown|prompt
push-only|remotely-modified|unknown|noop
pull-only|remotely-modified|unknown|skip-dirty
bidirectional|synced/record|0|record-baseline
push-only|synced/record|0|record-baseline
pull-only|synced/record|0|record-baseline
bidirectional|synced/record|1|record-baseline
bidirectional|locally-modified/withheld|0|push-without-title
push-only|locally-modified/withheld|0|push-without-title
pull-only|locally-modified/withheld|0|noop
bidirectional|locally-modified/retitle|0|retitle
push-only|locally-modified/retitle|0|retitle
pull-only|locally-modified/retitle|0|noop
bidirectional|locally-modified/record|0|record-baseline
push-only|locally-modified/record|0|record-baseline
pull-only|locally-modified/record|0|record-baseline

[TOKEN]
  REMOTE |accept-remote
local|push-local
skip|skip
(empty)|skip
frobnicate|skip
(nbsp)remote|skip
