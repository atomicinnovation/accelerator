{
  "family": "P1",
  "title": "Proposals honour the configured breadth",
  "scenarios": [
    {
      "name": "p1-ask",
      "verb": "ask",
      "question": "Which GPUs, datasets, licences and hosts suit agent training?",
      "times": 3,
      "setup": {
        "variant": "equivalence",
        "breadth": 2
      },
      "gate": "open",
      "turns": [
        {
          "expect": {
            "coverage": "unanswered",
            "proposal": {
              "max_items": 2,
              "profiles": [
                "web",
                "openalex"
              ]
            },
            "offers": "proposal",
            "writes": []
          }
        },
        {
          "reply": "confirm",
          "expect": {
            "writes": [
              "outline.md",
              "manifest.md"
            ],
            "appended_round": 4,
            "manifest": {
              "fields": {
                "status": "researching",
                "round_count": 3,
                "finding_count": 10
              },
              "lists_reports": true
            },
            "next_steps": true,
            "unchanged": [
              "reports/*"
            ]
          }
        }
      ]
    },
    {
      "name": "p1-report",
      "verb": "report",
      "question": "Which GPUs, datasets, licences and hosts suit agent training?",
      "times": 3,
      "setup": {
        "variant": "equivalence",
        "mutations": [
          {
            "set": "manifest.md",
            "field": "status",
            "value": "complete"
          }
        ],
        "breadth": 2
      },
      "gate": "open",
      "turns": [
        {
          "expect": {
            "coverage": "unanswered",
            "proposal": {
              "max_items": 2,
              "profiles": [
                "web",
                "openalex"
              ]
            },
            "offers": "proposal",
            "writes": []
          }
        },
        {
          "reply": "confirm",
          "expect": {
            "writes": [
              "outline.md",
              "manifest.md"
            ],
            "appended_round": 4,
            "manifest": {
              "fields": {
                "status": "researching",
                "round_count": 3,
                "finding_count": 10
              },
              "lists_reports": true
            },
            "next_steps": true,
            "unchanged": [
              "reports/*"
            ]
          }
        }
      ]
    }
  ]
}
