{
  "family": "G1",
  "title": "The status gate",
  "scenarios": [
    {
      "name": "g1-briefed-ask",
      "verb": "ask",
      "question": "How do LLM agents plan multi-step tasks?",
      "times": 1,
      "setup": {
        "variant": "base",
        "mutations": [
          {
            "set": "manifest.md",
            "field": "status",
            "value": "briefed"
          }
        ]
      },
      "gate": "status",
      "turns": [
        {
          "expect": {
            "refusal": {
              "gate": "status",
              "names": [
                "briefed",
                "Run outline llm-agent-planning, then conduct llm-agent-planning, then synthesise llm-agent-planning."
              ],
              "omits": [
                "synthesis is stale",
                "is not fully conducted"
              ]
            }
          }
        }
      ]
    },
