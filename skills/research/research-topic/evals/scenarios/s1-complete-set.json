{
  "family": "S1",
  "title": "A complete set is consultable",
  "scenarios": [
    {
      "name": "s1-complete-ask",
      "verb": "ask",
      "question": "How do LLM agents plan multi-step tasks?",
      "times": 3,
      "setup": {
        "variant": "base",
        "mutations": [
          {
            "set": "manifest.md",
            "field": "status",
            "value": "complete"
          }
        ]
      },
      "gate": "open",
      "turns": [
        {
          "expect": {
            "coverage": "answered",
            "writes": []
          }
        }
      ]
    },
    {
      "name": "s1-complete-report",
      "verb": "report",
      "question": "How do LLM agents plan multi-step tasks?",
      "times": 3,
      "setup": {
        "variant": "base",
        "mutations": [
          {
            "set": "manifest.md",
            "field": "status",
            "value": "complete"
          }
        ]
      },
      "gate": "open",
      "turns": [
        {
          "expect": {
            "coverage": "answered",
            "offers": "accept",
            "writes": []
          }
        },
        {
          "reply": "accept",
          "expect": {
            "writes": [
              "reports/how-do-llm-agents-plan-multi-step-tasks.md",
              "manifest.md"
            ],
            "manifest": {
              "fields": {
                "status": "complete",
                "report_count": 1
              },
              "lists_reports": true
            }
          }
        }
      ]
    }
  ]
}
