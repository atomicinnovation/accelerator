{
  "family": "G2",
  "title": "The freshness gate",
  "scenarios": [
    {
      "name": "g2-round-count-ask",
      "verb": "ask",
      "question": "How do LLM agents plan multi-step tasks?",
      "times": 1,
      "setup": {
        "variant": "base",
        "mutations": [
          {
            "set": "manifest.md",
            "field": "round_count",
            "value": 2
          }
        ]
      },
      "gate": "freshness",
      "turns": [
        {
          "expect": {
            "refusal": {
              "gate": "freshness",
              "names": [
                "manifest.md records round_count 2 but the findings reach round 3"
              ],
              "omits": [
                "needs synthesised or complete",
                "is not fully conducted"
              ]
            }
          }
        }
      ]
    },
