{
  "family": "E1",
  "title": "report finds equivalent reports",
  "scenarios": [
    {
      "name": "e1-work-out-plans-rewrite",
      "verb": "report",
      "question": "How do LLM agents work out plans for multi-step tasks?",
      "times": 3,
      "setup": {
        "variant": "equivalence"
      },
      "gate": "open",
      "turns": [
        {
          "expect": {
            "equivalents": [
              "reports/how-do-llm-agents-plan-multi-step-tasks.md"
            ],
            "offers": "pick",
            "writes": []
          }
        },
        {
          "reply": {
            "rewrite": 1
          },
          "expect": {
            "writes": [
              "reports/how-do-llm-agents-plan-multi-step-tasks.md",
              "manifest.md"
            ],
            "report": {
              "path": "reports/how-do-llm-agents-plan-multi-step-tasks.md",
              "fields": {
                "status": "complete"
              },
              "kept": [
                "id",
                "title",
                "question",
                "date",
                "parent",
                "relates_to"
              ]
            },
            "manifest": {
              "fields": {
                "report_count": 3
              },
              "lists_reports": true
            }
          }
        }
      ]
    },
