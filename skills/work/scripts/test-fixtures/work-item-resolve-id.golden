# work-item-resolve-id.sh golden file.
# Cross-checked against a real invocation of work-item-common.sh's
# classify_input/resolve cascade (extracted verbatim from
# work-item-resolve-id.sh) at implementation time — see Phase 1 of the
# 0170 implementation plan.
#
# Section CLASSIFY: <pattern>|<input>|<expected_class>
# classify_input never touches the filesystem or config beyond the
# pattern string, so this section has no project/setup columns.

[CLASSIFY]
{number:04d}|42|bare_number
{number:04d}|0042|bare_number
{number:04d}|abc|invalid
{number:04d}|./foo.md|path
{number:04d}|foo/bar.md|path
{number:04d}|/abs/foo.md|path
{project}-{number:04d}|PROJ-0042|full_id
{project}-{number:04d}|42|bare_number
{project}-{number:04d}|abc|invalid

# Section SEARCH: <pattern>|<default_project>|<setup files, comma-separated>|<input>|<class>|<exit_code>|<expected>
# expected is the matched path (exit 0), or, for exit 2 (Ambiguous), the
# "|"-joined list of "path [tag]" pairs in the order resolve() emits them
# (first-source-wins de-duplication order: project-prepended, legacy,
# pattern-shape, cross-project), or the not-found message (exit 3).
# Paths below are WORK_DIR-relative; the Rust unit tests resolve them
# against an in-memory DirectoryLister double, not real files.

[SEARCH]
{number:04d}||0042-foo.md|42|bare_number|0|0042-foo.md
{number:04d}||0042-foo.md,0042-bar.md|42|bare_number|2|0042-bar.md [legacy]|0042-foo.md [legacy]
{number:04d}||(none)|99|bare_number|3|no work item matching bare number '99'
{project}-{number:04d}|PROJ|PROJ-0042-foo.md|PROJ-0042|full_id|0|PROJ-0042-foo.md
{project}-{number:04d}|PROJ|PROJ-0042-foo.md,PROJ-0042-bar.md|PROJ-0042|full_id|2|PROJ-0042-bar.md|PROJ-0042-foo.md
{project}-{number:04d}||(none)|PROJ-0042|full_id|3|no work item with ID 'PROJ-0042'
{project}-{number:04d}|PROJ|PROJ-0007-a.md,0007-b.md,OTHER-0007-c.md|7|bare_number|2|PROJ-0007-a.md [project-prepended]|0007-b.md [legacy]|OTHER-0007-c.md [OTHER]
{project}-{number:04d}||OTHER-0007-c.md|7|bare_number|0|OTHER-0007-c.md
