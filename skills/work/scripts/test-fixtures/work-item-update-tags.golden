# work-item-update-tags.sh golden file.
# Format: <initial tags repr>|<action>|<tag>|<exit_code>|<expected_output>
#
# <initial tags repr> is one of:
#   (absent)          — no tags: key in the frontmatter at all
#   [a, b, ...]        — a flow-style tags: value, verbatim
#   block:a,b           — tags: written in YAML block-list style (rejected)
# missing-file is handled separately (no tags repr column, see below).
#
# Cross-checked against a real invocation of work-item-update-tags.sh at
# implementation time — see Phase 1 of the 0170 implementation plan.

[a, b]|add|c|0|[a, b, c]
[a, b]|add|a|0|no-change
[a, b]|remove|a|0|[b]
[a, b]|remove|zzz|0|no-change
(absent)|add|x|0|[x]
(absent)|remove|x|0|no-change
block:a,b|add|c|1|Error: tags field is in block format — convert to tags: [...] first. Example: tags: [api, search]
[a, "c,d"]|add|e|0|[a, c, d, e]
[a, "c,d"]|remove|c|0|[a, d]
[needs:colon, needs#hash]|add|z|0|["needs:colon", "needs#hash", z]

[MISSING_FILE]
add|z|1|Error: file not found: <path>
